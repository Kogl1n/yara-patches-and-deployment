index 00000000..2929fb54
--- /dev/null
+++ b/lib/src/modules/hash/ssdeep.rs
@@ -0,0 +1,416 @@
+//! Context triggered piecewise hashing (CTPH), also known as ssdeep.
+//!
+//! This is an implementation of the algorithm described by Jesse Kornblum in
+//! "Identifying almost identical files using context triggered piecewise
+//! hashing" (Digital Investigation, 2006), which is in turn based on Andrew
+//! Tridgell's spamsum. The digests produced by [`hash`] and the scores
+//! produced by [`compare`] are compatible with those of the `ssdeep` tool
+//! (libfuzzy 2.14), which are also the values shown by VirusTotal.
+
+/// Size of the rolling hash window.
+const ROLLING_WINDOW: usize = 7;
+
+/// Smallest block size.
+const MIN_BLOCK_SIZE: u64 = 3;
+
+/// Maximum length of each part of the digest.
+const SPAMSUM_LENGTH: usize = 64;
+
+/// Number of block sizes (MIN_BLOCK_SIZE * 2^i, i in 0..NUM_BLOCK_HASHES).
+const NUM_BLOCK_HASHES: usize = 31;
+
+/// Initial value of the piecewise hashes, only the lower 6 bits matter.
+const HASH_INIT: u32 = 0x28021967;
+
+/// Multiplier of the FNV-style piecewise hash.
+const HASH_PRIME: u32 = 0x01000193;
+
+const B64: &[u8; 64] =
+    b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+#[inline]
+fn block_size(index: usize) -> u64 {
+    MIN_BLOCK_SIZE << index
+}
+
+#[inline]
+fn sum_hash(c: u8, h: u32) -> u32 {
+    h.wrapping_mul(HASH_PRIME) ^ (c as u32)
+}
+
+/// Rolling hash over the last [`ROLLING_WINDOW`] bytes. It is the sum of
+/// three components: the sum of the bytes, a sum weighted by position, and a
+/// shift/xor hash.
+#[derive(Default)]
+struct RollingHash {
+    window: [u8; ROLLING_WINDOW],
+    h1: u32,
+    h2: u32,
+    h3: u32,
+    n: usize,
+}
+
+impl RollingHash {
+    #[inline]
+    fn update(&mut self, c: u8) {
+        self.h2 = self.h2.wrapping_sub(self.h1);
+        self.h2 = self.h2.wrapping_add(ROLLING_WINDOW as u32 * c as u32);
+        self.h1 = self.h1.wrapping_add(c as u32);
+        self.h1 = self.h1.wrapping_sub(self.window[self.n] as u32);
+        self.window[self.n] = c;
+        self.n = (self.n + 1) % ROLLING_WINDOW;
+        self.h3 = (self.h3 << 5) ^ (c as u32);
+    }
+
+    #[inline]
+    fn sum(&self) -> u32 {
+        self.h1.wrapping_add(self.h2).wrapping_add(self.h3)
+    }
+}
+
+/// State of the piecewise hash for a single block size.
+#[derive(Clone)]
+struct BlockHash {
+    /// Hash of the current piece.
+    h: u32,
+    /// Hash of the current piece, used for the truncated (half) digest.
+    half_h: u32,
+    digest: [u8; SPAMSUM_LENGTH],
+    /// Last character of the truncated digest.
+    half_digest: Option<u8>,
+    len: usize,
+}
+
+impl BlockHash {
+    fn new() -> Self {
+        Self {
+            h: HASH_INIT,
+            half_h: HASH_INIT,
+            digest: [0; SPAMSUM_LENGTH],
+            half_digest: None,
+            len: 0,
+        }
+    }
+}
+
+struct Hasher {
+    roll: RollingHash,
+    blocks: Vec<BlockHash>,
+    /// Index of the smallest block size still being considered.
+    start: usize,
+    /// Hash of the last piece for the largest block size, only computed
+    /// once all block sizes are in use.
+    last_h: Option<u32>,
+    /// Total input length.
+    total_size: u64,
+}
+
+impl Hasher {
+    fn new(total_size: u64) -> Self {
+        Self {
+            roll: RollingHash::default(),
+            blocks: vec![BlockHash::new()],
+            start: 0,
+            last_h: None,
+            total_size,
+        }
+    }
+
+    /// Starts computing the hash for the next block size, which until now
+    /// had exactly the same state as the current largest one.
+    fn fork(&mut self) {
+        let last = self.blocks.last().unwrap();
+        if self.blocks.len() < NUM_BLOCK_HASHES {
+            let mut next = BlockHash::new();
+            next.h = last.h;
+            next.half_h = last.half_h;
+            self.blocks.push(next);
+        } else if self.last_h.is_none() {
+            self.last_h = Some(last.h);
+        }
+    }
+
+    /// Stops computing the hash for the smallest block size once it is
+    /// clear that it won't be used in the final digest.
+    fn try_reduce(&mut self) {
+        if self.blocks.len() - self.start < 2 {
+            return;
+        }
+        if block_size(self.start) * SPAMSUM_LENGTH as u64 >= self.total_size
+        {
+            return;
+        }
+        if self.blocks[self.start + 1].len < SPAMSUM_LENGTH / 2 {
+            return;
+        }
+        self.start += 1;
+    }
+
+    fn update(&mut self, c: u8) {
+        self.roll.update(c);
+
+        for block in &mut self.blocks[self.start..] {
+            block.h = sum_hash(c, block.h);
+            block.half_h = sum_hash(c, block.half_h);
+        }
+
+        if let Some(h) = self.last_h.as_mut() {
+            *h = sum_hash(c, *h);
+        }
+
+        let sum = self.roll.sum() as u64;
+        let mut i = self.start;
+
+        // A piece ends for block size `bs` when sum % bs == bs - 1. If that
+        // doesn't happen for a block size, it doesn't for larger ones.
+        while i < self.blocks.len() {
+            let bs = block_size(i);
+
+            if sum % bs != bs - 1 {
+                break;
+            }
+
+            if self.blocks[i].len == 0 {
+                self.fork();
+            }
+
+            let block = &mut self.blocks[i];
+
+            block.digest[block.len] = B64[(block.h % 64) as usize];
+            block.half_digest = Some(B64[(block.half_h % 64) as usize]);
+
+            if block.len < SPAMSUM_LENGTH - 1 {
+                // Only start a new piece if there is room for more
+                // characters, the last character of the digest covers the
+                // rest of the input.
+                block.len += 1;
+                block.h = HASH_INIT;
+                if block.len < SPAMSUM_LENGTH / 2 {
+                    block.half_h = HASH_INIT;
+                    block.half_digest = None;
+                }
+            } else {
+                self.try_reduce();
+            }
+
+            i += 1;
+        }
+    }
+
+    fn digest(&self) -> Option<String> {
+        let roll_sum = self.roll.sum();
+        let mut bi = self.start;
+
+        // Initial guess of the block size, based on the input size.
+        while block_size(bi) * (SPAMSUM_LENGTH as u64) < self.total_size {
+            bi += 1;
+            if bi >= NUM_BLOCK_HASHES {
+                return None;
+            }
+        }
+
+        // Adjust the guess so that the first part of the digest has at least
+        // SPAMSUM_LENGTH / 2 characters, if possible.
+        bi = bi.min(self.blocks.len() - 1);
+
+        while bi > self.start && self.blocks[bi].len < SPAMSUM_LENGTH / 2 {
+            bi -= 1;
+        }
+
+        let block = &self.blocks[bi];
+        let mut result = format!("{}:", block_size(bi));
+
+        result.push_str(
+            std::str::from_utf8(&block.digest[..block.len]).unwrap(),
+        );
+
+        if roll_sum != 0 {
+            result.push(B64[(block.h % 64) as usize] as char);
+        } else if block.len < SPAMSUM_LENGTH && block.digest[block.len] != 0
+        {
+            result.push(block.digest[block.len] as char);
+        }
+
+        result.push(':');
+
+        if bi < self.blocks.len() - 1 {
+            let block = &self.blocks[bi + 1];
+            let len = block.len.min(SPAMSUM_LENGTH / 2 - 1);
+
+            result.push_str(std::str::from_utf8(&block.digest[..len]).unwrap());
+
+            if roll_sum != 0 {
+                result.push(B64[(block.half_h % 64) as usize] as char);
+            } else if let Some(c) = block.half_digest {
+                result.push(c as char);
+            }
+        } else if roll_sum != 0 {
+            let h = if bi == 0 {
+                self.blocks[bi].h
+            } else {
+                self.last_h.unwrap_or(self.blocks[bi].h)
+            };
+            result.push(B64[(h % 64) as usize] as char);
+        }
+
+        Some(result)
+    }
+}
+
+/// Computes the ssdeep digest of the given data.
+///
+/// Returns `None` only if the data is too large (more than 192 GiB).
+pub fn hash(data: &[u8]) -> Option<String> {
+    let mut hasher = Hasher::new(data.len() as u64);
+
+    for c in data {
+        hasher.update(*c);
+    }
+
+    hasher.digest()
+}
+
+/// Copies `s`, removing characters that repeat more than three times in a
+/// row. Long runs of the same character carry little information and would
+/// inflate the similarity score.
+fn eliminate_sequences(s: &[u8]) -> Vec<u8> {
+    let mut result = Vec::with_capacity(s.len());
+    for (i, c) in s.iter().enumerate() {
+        if i < 3 || *c != s[i - 1] || *c != s[i - 2] || *c != s[i - 3] {
+            result.push(*c);
+        }
+    }
+    result
+}
+
+/// Returns true if `a` and `b` have a common substring of at least
+/// [`ROLLING_WINDOW`] characters.
+fn has_common_substring(a: &[u8], b: &[u8]) -> bool {
+    if a.len() < ROLLING_WINDOW || b.len() < ROLLING_WINDOW {
+        return false;
+    }
+    a.windows(ROLLING_WINDOW).any(|w| b.windows(ROLLING_WINDOW).any(|v| v == w))
+}
+
+/// Edit distance where insertions and deletions cost 1 and substitutions 2.
+fn edit_distance(a: &[u8], b: &[u8]) -> usize {
+    let mut prev: Vec<usize> = (0..=b.len()).collect();
+    let mut cur = vec![0; b.len() + 1];
+
+    for (i, ca) in a.iter().enumerate() {
+        cur[0] = i + 1;
+        for (j, cb) in b.iter().enumerate() {
+            let replace = prev[j] + if ca == cb { 0 } else { 2 };
+            cur[j + 1] = replace.min(prev[j + 1] + 1).min(cur[j] + 1);
+        }
+        std::mem::swap(&mut prev, &mut cur);
+    }
+
+    prev[b.len()]
+}
+
+/// Similarity score between 0 and 100 of two digest parts computed with
+/// the same block size.
+fn score_strings(a: &[u8], b: &[u8], block_size: u64) -> u32 {
+    if a.len() > SPAMSUM_LENGTH || b.len() > SPAMSUM_LENGTH {
+        return 0;
+    }
+
+    if !has_common_substring(a, b) {
+        return 0;
+    }
+
+    let mut score = edit_distance(a, b) as u64;
+
+    // Scale the edit distance by the lengths of the strings, and convert it
+    // to a 0-100 scale where 100 means identical.
+    score = (score * SPAMSUM_LENGTH as u64) / (a.len() + b.len()) as u64;
+    score = (100 * score) / SPAMSUM_LENGTH as u64;
+    score = 100 - score;
+
+    // When the block size is small, don't exaggerate the match size.
+    let threshold = (99 + ROLLING_WINDOW as u64) / ROLLING_WINDOW as u64
+        * MIN_BLOCK_SIZE;
+
+    if block_size < threshold {
+        let cap = block_size / MIN_BLOCK_SIZE * a.len().min(b.len()) as u64;
+        score = score.min(cap);
+    }
+
+    score as u32
+}
+
+/// A parsed digest: block size and the two parts.
+struct Digest<'a> {
+    block_size: u64,
+    part1: &'a [u8],
+    part2: &'a [u8],
+}
+
+fn parse(digest: &str) -> Option<Digest<'_>> {
+    let (block_size, rest) = digest.split_once(':')?;
+
+    if block_size.is_empty() || !block_size.bytes().all(|c| c.is_ascii_digit())
+    {
+        return None;
+    }
+
+    let block_size = block_size.parse::<u64>().ok()?;
+    let (part1, part2) = rest.split_once(':')?;
+
+    // The digest may be followed by a comma and a file name, as in the
+    // output of the `ssdeep` tool.
+    let part2 = match part2.split_once(',') {
+        Some((p, _)) => p,
+        None => part2,
+    };
+
+    if part1.len() > SPAMSUM_LENGTH || part2.len() > SPAMSUM_LENGTH {
+        return None;
+    }
+
+    Some(Digest {
+        block_size,
+        part1: part1.as_bytes(),
+        part2: part2.as_bytes(),
+    })
+}
+
+/// Compares two ssdeep digests and returns a similarity score between 0
+/// (no similarity) and 100 (identical or near-identical).
+///
+/// Returns `None` if any of the digests is malformed.
+pub fn compare(digest1: &str, digest2: &str) -> Option<u32> {
+    let d1 = parse(digest1)?;
+    let d2 = parse(digest2)?;
+
+    let (bs1, bs2) = (d1.block_size, d2.block_size);
+
+    // Digests can only be compared if their block sizes are equal or one
+    // is twice the other.
+    if bs1 != bs2
+        && bs1.checked_mul(2) != Some(bs2)
+        && (bs1 % 2 == 1 || bs1 / 2 != bs2)
+    {
+        return Some(0);
+    }
+
+    let a1 = eliminate_sequences(d1.part1);
+    let a2 = eliminate_sequences(d1.part2);
+    let b1 = eliminate_sequences(d2.part1);
+    let b2 = eliminate_sequences(d2.part2);
+
+    if bs1 == bs2 && a1 == b1 && a2 == b2 {
+        return Some(100);
+    }
+
+    let score = if bs1 == bs2 {
+        score_strings(&a1, &b1, bs1).max(score_strings(&a2, &b2, bs1 * 2))
+    } else if bs1 == bs2 * 2 {
+        score_strings(&a1, &b2, bs1)
+    } else {
+        score_strings(&a2, &b1, bs2)
+    };
+
+    Some(score)
+}
