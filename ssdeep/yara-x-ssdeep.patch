+/// Calculates the ssdeep fuzzy hash of a portion of the scanned data.
+#[module_export(name = "ssdeep")]
+fn ssdeep_data(
+    ctx: &mut ScanContext,
+    offset: i64,
+    size: i64,
+) -> Option<RuntimeString> {
+    let cached = SSDEEP_CACHE
+        .with(|cache| cache.borrow().get(&(offset, size)).cloned());
+
+    if let Some(digest) = cached {
+        return Some(RuntimeString::new(digest));
+    }
+
+    let data = data_slice(ctx, offset, size)?;
+    let digest = ssdeep::hash(data)?;
+
+    SSDEEP_CACHE.with(|cache| {
+        cache.borrow_mut().insert((offset, size), digest.clone());
+    });
+
+    Some(RuntimeString::new(digest))
+}
+
+/// Calculates the ssdeep fuzzy hash of a string.
+#[module_export(name = "ssdeep")]
+fn ssdeep_str(ctx: &mut ScanContext, s: RuntimeString) -> Option<RuntimeString> {
+    Some(RuntimeString::new(ssdeep::hash(s.as_bstr(ctx))?))
+}
+
+/// Compares two ssdeep fuzzy hashes and returns a similarity score between
+/// 0 (no similarity) and 100 (identical or near-identical). The result is
+/// undefined if any of the hashes is malformed.
+#[module_export(name = "ssdeep_compare")]
+fn ssdeep_compare(
+    ctx: &mut ScanContext,
+    hash1: RuntimeString,
+    hash2: RuntimeString,
+) -> Option<i64> {
+    let hash1 = hash1.as_bstr(ctx).to_str().ok()?;
+    let hash2 = hash2.as_bstr(ctx).to_str().ok()?;
+
+    Some(ssdeep::compare(hash1, hash2)?.into())
+}
