+#if defined(HASH_SSDEEP)
+  declare_function("ssdeep", "ii", "s", data_ssdeep);
+  declare_function("ssdeep", "s", "s", string_ssdeep);
+  declare_function("ssdeep_compare", "ss", "i", ssdeep_compare);
+#endif
 end_declarations
 
